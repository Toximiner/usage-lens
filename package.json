{
  "name": "universal-usage-lens",
  "displayName": "Universal Usage Lens",
  "icon": "icon.png",
  "description": "Reference counts for Python, TypeScript, JavaScript and other languages, without blank CodeLens rows.",
  "version": "0.1.3",
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "codelens",
    "references",
    "usages",
    "python",
    "typescript",
    "react",
    "css"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "bugs": {
    "url": "https://github.com/Toximiner/usage-lens/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Toximiner/usage-lens"
  },
  "license": "MIT",
  "author": {
    "name": "RafaelPeter",
    "url": "https://github.com/rafaelpeter03"
  },
  "publisher": "Toximiner",
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "usageLens.toggle",
        "title": "%command.toggle.title%"
      },
      {
        "command": "usageLens.refresh",
        "title": "%command.refresh.title%"
      }
    ],
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "usageLens.enable": {
          "type": "boolean",
          "default": true,
          "description": "%config.enable.description%",
          "scope": "resource"
        },
        "usageLens.files.includeInitPy": {
          "type": "boolean",
          "default": true,
          "description": "%config.files.includeInitPy.description%",
          "scope": "resource"
        },
        "usageLens.targets.classes": {
          "type": "boolean",
          "default": true,
          "description": "%config.targets.classes.description%",
          "scope": "resource"
        },
        "usageLens.targets.methods": {
          "type": "boolean",
          "default": true,
          "description": "%config.targets.methods.description%",
          "scope": "resource"
        },
        "usageLens.targets.functions": {
          "type": "boolean",
          "default": true,
          "description": "%config.targets.functions.description%",
          "scope": "resource"
        },
        "usageLens.targets.moduleVariables": {
          "type": "boolean",
          "default": true,
          "description": "%config.targets.moduleVariables.description%",
          "scope": "resource"
        },
        "usageLens.targets.imports.project": {
          "type": "boolean",
          "default": false,
          "description": "%config.targets.imports.project.description%",
          "scope": "resource"
        },
        "usageLens.targets.imports.venv": {
          "type": "boolean",
          "default": false,
          "description": "%config.targets.imports.venv.description%",
          "scope": "resource"
        },
        "usageLens.targets.imports.stdlib": {
          "type": "boolean",
          "default": false,
          "description": "%config.targets.imports.stdlib.description%",
          "scope": "resource"
        },
        "usageLens.targets.imports.global": {
          "type": "boolean",
          "default": false,
          "description": "%config.targets.imports.global.description%",
          "scope": "resource"
        },
        "usageLens.references.filterImports": {
          "type": "boolean",
          "default": false,
          "description": "%config.references.filterImports.description%",
          "scope": "resource"
        },
        "usageLens.references.filterDefinitions": {
          "type": "boolean",
          "default": true,
          "description": "%config.references.filterDefinitions.description%",
          "scope": "resource"
        },
        "usageLens.references.filterSelf": {
          "type": "boolean",
          "default": false,
          "description": "%config.references.filterSelf.description%",
          "scope": "resource"
        },
        "usageLens.references.minCount": {
          "type": "number",
          "default": 0,
          "description": "%config.references.minCount.description%",
          "scope": "resource"
        },
        "usageLens.references.showZero": {
          "type": "boolean",
          "default": false,
          "description": "%config.references.showZero.description%",
          "scope": "resource"
        },
        "usageLens.lenses.showImplementations": {
          "type": "boolean",
          "default": false,
          "description": "%config.lenses.showImplementations.description%",
          "scope": "resource"
        },
        "usageLens.clickAction": {
          "type": "string",
          "enum": [
            "peek",
            "reveal"
          ],
          "default": "peek",
          "description": "%config.clickAction.description%",
          "scope": "resource"
        },
        "usageLens.performance.debounceMs": {
          "type": "number",
          "default": 200,
          "description": "%config.performance.debounceMs.description%",
          "scope": "resource"
        },
        "usageLens.performance.maxFileSizeKB": {
          "type": "number",
          "default": 10240,
          "description": "%config.performance.maxFileSizeKB.description%",
          "scope": "resource"
        },
        "usageLens.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/.venv/**",
            "**/venv/**",
            "**/site-packages/**",
            "**/__pycache__/**",
            "**/node_modules/**",
            "**/dist/**",
            "**/build/**",
            ".git/**"
          ],
          "description": "%config.exclude.description%",
          "scope": "resource"
        },
        "usageLens.languages": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "python",
            "typescript",
            "typescriptreact",
            "javascript",
            "javascriptreact",
            "css",
            "scss",
            "less",
            "postcss"
          ],
          "description": "Language IDs to enable. Each language needs document symbol and reference providers. PostCSS requires a matching provider or CSS language mode.",
          "scope": "resource"
        },
        "usageLens.targets.types": {
          "type": "boolean",
          "default": true,
          "description": "Show counts for interfaces, type aliases, enums and structs.",
          "scope": "resource"
        }
      }
    }
  },
  "scripts": {
    "check": "tsc --noEmit",
    "lint": "eslint src",
    "test:imports": "node scripts/test-import-detector.mjs",
    "verify": "npm run check && npm run lint && npm run test:imports && npm run test:provider",
    "test": "npm run verify",
    "precommit": "npm run verify",
    "prepush": "npm run verify",
    "compile": "node esbuild.mjs",
    "prepublish": "npm run test && npm run compile -- --production",
    "watch": "node esbuild.mjs --watch",
    "package": "npm run prepublish && vsce package --no-dependencies",
    "prepare": "husky",
    "test:provider": "node scripts/test-provider.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@commitlint/prompt-cli": "^21.0.2",
    "@eslint/js": "10.0.1",
    "@types/node": "25.9.3",
    "@types/vscode": "1.96.0",
    "@typescript-eslint/eslint-plugin": "8.59.3",
    "@typescript-eslint/parser": "8.61.0",
    "@vscode/vsce": "4.1.1",
    "esbuild": "0.28.0",
    "eslint": "10.4.1",
    "husky": "9.1.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.61.0"
  },
  "engines": {
    "vscode": "^1.96.0"
  }
}
